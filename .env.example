# SMTP email provider
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
FROM_EMAIL=notifications@example.com

# Application dependencies
DATABASE_URL=postgresql+psycopg2://notification_user:notification_password@localhost:5432/notification_db
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqps://your_rabbitmq_username:your_rabbitmq_password@your_rabbitmq_host/your_rabbitmq_vhost

# Rate limiting
RATE_LIMIT_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=60

# Simulated provider used during load testing
LOAD_TEST_MODE=false
LOAD_TEST_PROVIDER_MIN_MS=20
LOAD_TEST_PROVIDER_MAX_MS=80
LOAD_TEST_PROVIDER_FAILURE_RATE=0

# RabbitMQ management API used by queue-drain measurement
RABBITMQ_MANAGEMENT_URL=https://your_rabbitmq_host
RABBITMQ_USERNAME=your_rabbitmq_username
RABBITMQ_PASSWORD=your_rabbitmq_password
RABBITMQ_VHOST=your_rabbitmq_vhost
RABBITMQ_QUEUE=notification.delivery

# Grafana
GRAFANA_ADMIN_PASSWORD=choose_a_secure_password
